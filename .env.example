# Salin ke .env lalu isi nilai rahasia. JANGAN commit .env.
# Buat nilai acak, mis.: openssl rand -base64 48

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=snr
POSTGRES_USER=snr
POSTGRES_PASSWORD=

# Direktori data di host (evidence, profil browser, postgres, backup, ekspor).
SNR_HOST_DATA=./snr-data
# UID/GID pemilik direktori data (samakan dengan user host: id -u / id -g).
SNR_UID=1000
SNR_GID=1000

# Penyapu run basi (celery beat): isi KEDUANYA untuk mengaktifkan; kosong = tidak dijadwalkan.
# Tanpa angka bawaan: tetapkan dari hasil `docker compose exec web python manage.py
# inspection_durations` pada adapter yang dipakai (nilai harus > durasi run terlama yang sah dan
# > SNR_INSPECTION_SOFT_TIME_LIMIT bila diset). Contoh di bawah hanya penampung untuk pengembangan.
# SNR_SWEEP_OLDER_THAN_SECONDS=900
# SNR_SWEEP_INTERVAL_SECONDS=60

# HTTPS (overlay compose.tls.yaml; lihat docs/operations.md). Hanya dipakai bila overlay dijalankan.
# SNR_DOMAIN=snr.contoh.test
# DJANGO_ALLOWED_HOSTS=snr.contoh.test            # wajib eksplisit pada mode HTTPS (tanpa '*')
# DJANGO_CSRF_TRUSTED_ORIGINS=https://snr.contoh.test
# SNR_TLS=internal                                 # atau: /certs/cert.pem /certs/key.pem
# SNR_HSTS_SECONDS=3600                            # nilai awal usulan; naikkan bertahap
# SNR_BIND_ADDR=127.0.0.1                          # ubah hanya dengan sengaja
