# Salin ke .env lalu isi nilai rahasia. JANGAN commit .env.
# Buat nilai acak, mis.: openssl rand -base64 48

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=snr
POSTGRES_USER=snr
POSTGRES_PASSWORD=

# Direktori data di host (evidence, profil browser, postgres, backup, ekspor).
SNR_HOST_DATA=./snr-data
# UID/GID pemilik direktori data (samakan dengan user host: id -u / id -g).
SNR_UID=1000
SNR_GID=1000
